{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mobile": "node scripts/start-mobile.mjs",
    "mobile:live": "node scripts/start-mobile.mjs --live",
    "mobile:bundle": "node scripts/build-game-bundle.mjs",
    "mobile:install": "npm --prefix mobile install",
    "mobile:setup": "npm install && npm --prefix mobile install",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:ipa": "npm --prefix mobile run build:ios",
    "mobile:ipa:sim": "npm --prefix mobile run build:ios:sim",
    "mobile:apk": "npm --prefix mobile run build:android"
  },
  "dependencies": {
    "@types/matter-js": "^0.20.2",
    "clsx": "2.1.1",
    "matter-js": "^0.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
