{
  "name": "kitty-drop-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Expo (iOS + Android) shell that hosts the Kitty Drop web game in a WebView.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:ios": "npx --yes eas-cli build --platform ios --profile preview",
    "build:ios:sim": "npx --yes eas-cli build --platform ios --profile simulator",
    "build:android": "npx --yes eas-cli build --platform android --profile preview",
    "update:preview": "npx --yes eas-cli update --channel preview --message \"kitty drop update\"",
    "update:production": "npx --yes eas-cli update --channel production --message \"kitty drop update\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/react-native-skia": "^2.6.2",
    "@types/matter-js": "^0.20.2",
    "expo": "~57.0.20",
    "expo-audio": "~57.0.4",
    "expo-haptics": "~57.0.2",
    "expo-keep-awake": "~57.0.1",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "matter-js": "^0.20.0",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
